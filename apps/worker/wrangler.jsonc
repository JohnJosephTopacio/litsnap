{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "litsnap-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true,
  },
  // One RateLimiter per client IP (lookup-api.md, decision 0004). Free only allows SQLite-backed
  // Durable Objects, even though this one stores nothing.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
}
